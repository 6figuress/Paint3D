Bootstrap: docker
From: centos:7

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/app

%files
    * /opt/app

%environment
    export PATH=/opt/conda/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/usr/local/cuda/bin:$PATH

%post
    # Update repositories to use vault.centos.org
    sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*
    sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*

    # Install system dependencies
    yum -y update
    yum -y groupinstall "Development Tools"
    yum -y install wget which epel-release

    # Install Miniconda
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh

    # Add conda to path
    export PATH=/opt/conda/bin:$PATH

    # Create conda environment
    cd /opt/app
    conda env create -f environment.yaml

    # Activate conda environment and install Kaolin
    . /opt/conda/etc/profile.d/conda.sh
    conda activate base
    pip install https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-1.12.1_cu116/kaolin-0.13.0-cp39-cp39-linux_x86_64.whl

    # Clean up
    conda clean -afy
    rm -rf /var/cache/yum/*
    yum clean all

%runscript
    . /opt/conda/etc/profile.d/conda.sh
    conda activate base
    exec "$@"

%labels
    Author Osmani Dion
    Version v1.0
    CUDA_Version 11.6
    PyTorch_Version 1.12.1
